# --- Environment Configuration ---
APP_ENV=development
DEBUG=true

# --- Database Configuration ---
# Use 'host.docker.internal' if the DB is on your Mac and the app is in Docker[cite: 582].
# Port 5433 is used here because 5432 is often occupied by local Postgres[cite: 37, 466].
DB_HOST=localhost
DB_PORT=5433
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# --- Security ---
# Generate a long random string for production[cite: 300, 605, 671].
SECRET_KEY=change_me_to_a_random_string
